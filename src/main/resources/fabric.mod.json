{
	"schemaVersion": 1,
	"id": "fulloverlay",
	"version": "${version}",
	"name": "FullOverlay",
	"description": "Edit, move or hide every overlay in Minecraft.",
	"authors": [
		"adryxv"
	],
	"contact": {
		"homepage": "https://github.com/adryxv/fulloverlay",
		"sources": "https://github.com/adryxv/fulloverlay"
	},
	"license": "MIT",
	"icon": "assets/fulloverlay/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.adryxv.fulloverlay.FullOverlay"
		],
		"client": [
			"com.adryxv.fulloverlay.client.FullOverlayClient"
		]
	},
	"mixins": [
		"fulloverlay.mixins.json",
		{
			"config": "fulloverlay.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}